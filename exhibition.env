# Shared defaults for both PCs. Connection changes require restarting the launchers.
# Controller label changes only require reloading the affected PC's browser.
MULTIPLAYER_MODE=lan
# Docker on the exhibition host already occupies 8080; both PCs use 8081.
MULTIPLAYER_SERVER_URL=ws://10.10.10.1:8081
CLIENT_PORT=4173
EXHIBITION_ROOM=EXHIBITION
OPEN_BROWSER=1
# Button labels for each display PC. Edit locally, then reload that PC's browser.
PC1_CONTROLLER_LAYOUT=ps4
PC2_CONTROLLER_LAYOUT=switch-pro
