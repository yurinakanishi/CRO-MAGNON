{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cro-magnon-free",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/api/*"],
    "not_found_handling": "none"
  },
  "durable_objects": { "bindings": [{ "name": "GAME", "class_name": "FreeGameRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FreeGameRoom"] }],
  "vars": { "SERVICE_ENABLED": "true" },
  "observability": { "enabled": false },
  "send_metrics": false
}
