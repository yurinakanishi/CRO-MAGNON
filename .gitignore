# Full coastal reconstruction intermediates are SHA-verified in the model archive.
# Keep source references, workflows, accepted geometry and QA in this repository.
assets/coastal-craft/models/*/work/
# Per-model archive copies of QA already retained under assets/coastal-craft.
assets/coastal-craft/models/*/qa/game-views/
assets/coastal-craft/models/*/qa/appearance-views/
assets/coastal-craft/models/*/qa/static-comparison/
assets/coastal-craft/models/*/qa/static-config.json

# Full camp landform reconstruction intermediates stay in the local model archive.
# Keep source references, workflows, accepted models and QA in this repository.
assets/camp-cave/work/
assets/camp-mountain/work/

# Female face reconstruction binaries stay in the local archive.
# Commit references, build records, QA and the adopted models under public/models.
assets/female-face-repair/*/work/**/*.glb
assets/female-face-repair/*/work/**/*.ply
assets/female-face-repair/*/work/**/*.png
